{
  "name": "haplotype-wallet-js-example",
  "version": "0.1.0",
  "private": true,
  "description": "Connect Haplotype Wallet from a Node.js server: OAuth authorization code flow, then MCP tool calls.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "test": "vitest run",
    "lint": "eslint . && pnpm contract:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "contract:generate": "node scripts/generate-contract.ts",
    "contract:check": "node scripts/generate-contract.ts --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.2"
}
