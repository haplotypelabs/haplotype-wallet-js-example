# Copy to .env and fill in. `pnpm start` loads .env automatically.

# Your app's credentials, from Haplotype Labs. Required.
WALLET_CLIENT_ID=
WALLET_CLIENT_SECRET=

# Signs the session cookie. Any long random string, e.g. `openssl rand -hex 32`. Required.
SESSION_SECRET=

# Haplotype Wallet environment. Defaults are production:
#   WALLET_ISSUER=https://authkit.haplotype.ai
#   WALLET_MCP_URL=https://api.haplotype.ai/mcp
# Staging:
#   WALLET_ISSUER=https://great-countryside-82-staging.authkit.app
#   WALLET_MCP_URL=https://api.stage.haplotype.ai/mcp
WALLET_ISSUER=https://authkit.haplotype.ai
WALLET_MCP_URL=https://api.haplotype.ai/mcp

# Scopes to request. offline_access gives a refresh token; without it the user
# has to connect again every 15 minutes. Request only wallet scopes your app is
# approved for, or the wallet answers invalid_scope.
WALLET_SCOPES=openid offline_access samples:read

# Where this app runs. The redirect URI is APP_URL + /callback, and it must be
# registered for your client.
APP_URL=http://localhost:8787
PORT=8787

# Test-only routes for automated tests (POST /debug/expire-token). Off unless
# set to 1. Never enable in production.
# EXAMPLE_TEST_HOOKS=1
